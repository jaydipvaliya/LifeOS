{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos",
    "scheme": "lifeos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF8FF",
    "splash": {
      "backgroundColor": "#FAF8FF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifeos.app"
    },
    "android": {
      "package": "com.lifeos.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "LifeOS uses the camera to scan receipts, certificates, and documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LifeOS accesses your selected photos to upload documents to your private Vault."
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#5B4AE6"
        }
      ],
      "@sentry/react-native"
    ]
  }
}
