NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8081
LOG_LEVEL=info

# PostgreSQL (configured in Day 2)
DATABASE_URL=postgresql://lifeos:lifeos_dev_password@localhost:5432/lifeos?schema=public

# Redis (used by BullMQ and rate limiting/cache)
REDIS_URL=redis://localhost:6379

# JWT Authentication (configured in Day 2)
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-plus-char-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Private Object Storage ("local" signed private disk for dev, "s3" for AWS S3/MinIO/R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_SIGNING_SECRET=replace-with-32-plus-char-storage-signing-secret
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=lifeos-documents-private
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_FORCE_PATH_STYLE=true

# AI Provider ("none" heuristic local mode, "openai", or "gemini")
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
