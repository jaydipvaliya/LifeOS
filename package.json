{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "description": "LifeOS — AI-Powered Personal Life Administration Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@lifeos/api",
    "dev:worker": "npm run dev --workspace=@lifeos/worker",
    "dev:mobile": "npm run start --workspace=@lifeos/mobile",
    "build": "tsc -b tsconfig.json",
    "typecheck": "npm run build && npm run typecheck --workspace=@lifeos/mobile",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
